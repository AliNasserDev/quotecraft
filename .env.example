NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_REPLACE_ME
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME
PADDLE_PRICE_SOLO_MONTHLY=pri_REPLACE_ME
PADDLE_PRICE_SOLO_ANNUAL=pri_REPLACE_ME
PADDLE_PRICE_STUDIO_MONTHLY=pri_REPLACE_ME
PADDLE_PRICE_STUDIO_ANNUAL=pri_REPLACE_ME

# RevenueCat public SDK keys. These are safe for client apps; never put a RevenueCat secret key here.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_sb_REPLACE_ME
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_REPLACE_ME
REVENUECAT_ENTITLEMENT_SOLO=quotecraft_solo
REVENUECAT_ENTITLEMENT_STUDIO=quotecraft_studio

# Server-only webhook verification. Use a random authorization value and RevenueCat HMAC signing secret.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer REPLACE_WITH_RANDOM_SECRET
REVENUECAT_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_REVENUECAT_SIGNING_SECRET
